# EzityHub REST API endpoint (internal Docker network or local dev URL)
EZITYHUB_API_URL=http://localhost:3000

# Dedicated Agent Bearer Token (ez_agt_live_...) with read-only accounting/finance permissions
# Required permissions:
# - accounting.journal.read
# - finance.bank.manage
# - finance.bank.reconcile
# - finance.invoice.read
EZITYHUB_API_TOKEN=ez_agt_live_example_token_here

# Request timeout in milliseconds (default: 15000)
EZITYHUB_TIMEOUT_MS=15000
